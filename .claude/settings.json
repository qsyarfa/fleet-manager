{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Bash(npm *)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
